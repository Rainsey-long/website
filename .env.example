# Copy to .env.local for development. In production set these on the Railway
# service (Variables tab). Variables marked BUILD must also be available at
# build time (Railway passes service variables to the Docker build as ARGs).

# Required in production. >=16 chars (32+ recommended). Signs the admin cookie.
AUTH_SECRET=
# Required on the FIRST boot of a fresh volume: creates the first admin. >=12 chars.
ADMIN_PASSWORD=
# Optional, default "admin".
ADMIN_USERNAME=

# BUILD. The absolute origin, e.g. https://yourdomain.com — canonicals, share links, sitemap.
NEXT_PUBLIC_SITE_URL=
# BUILD. Optional search-console verification meta tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Bearer token for GET /api/cron/backup. >=32 chars. Unset => 503, no backups.
BACKUP_SECRET=
# How many gzipped backups to keep in data/backups (default 7).
BACKUP_RETAIN=7

# Trusted reverse-proxy hops for per-caller rate limits. Railway: 1.
# Railway behind Cloudflare's orange-cloud proxy: 2. Too high is the dangerous direction.
TRUSTED_PROXY_HOPS=1

# Disk guard (lib/volumeHeadroom.ts): block new backup writes at this % used.
DISK_BLOCK_PCT=90
DISK_WARN_PCT=80

# Telegram daily card (GET /api/cron/telegram, lib/telegram.ts). All three or
# none; unset => the route answers 503 and nothing is posted.
# Bearer token the scheduler sends. >=32 chars, its own secret (not BACKUP_SECRET).
TELEGRAM_CRON_SECRET=
# From @BotFather. Server-only; never logged.
TELEGRAM_BOT_TOKEN=
# The channel: @channelname, or its numeric id (-100...). The bot must be an admin of it.
TELEGRAM_CHAT_ID=
# Tests only: a local mock of the Bot API, e.g. http://127.0.0.1:3999.
# In production it is honoured only when it names this machine (localhost).
TELEGRAM_API_BASE=

# Google AdSense (lib/ads.ts, docs/ADSENSE.md). All build-time: set them in
# Railway BEFORE the build. Leave empty to keep ads completely off.
# Step 1, before approval: the account id alone serves /ads.txt and the
# google-adsense-account meta tag, nothing else.
NEXT_PUBLIC_ADSENSE_ACCOUNT=
# Step 2, after approval: the publisher id turns on the tag (and Google's
# consent message, set up in AdSense -> Privacy & messaging) and widens the CSP.
NEXT_PUBLIC_AD_CLIENT_ID=
# One ad unit per placement (numeric slot ids from AdSense -> Ads -> By ad unit).
NEXT_PUBLIC_AD_SLOT_AFTER_READING=
NEXT_PUBLIC_AD_SLOT_IN_CONTENT=
NEXT_PUBLIC_AD_SLOT_RAIL=
