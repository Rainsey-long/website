{
  "name": "zodiac-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:blocks && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "validate:blocks": "node --experimental-strip-types scripts/validate-blocks.ts",
    "check:contrast": "node --experimental-strip-types scripts/check-contrast.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "generate:sky": "node --experimental-strip-types scripts/generate-sky.ts",
    "generate:daily": "node --experimental-strip-types scripts/generate-daily.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "astronomy-engine": "2.1.19",
    "lunar-javascript": "1.7.7",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
