---
/**
 * AdSlot (§6.11): a reserved fixed-height box so ads never shift layout.
 * Renders nothing while ads are off (site.ts FEATURES.ADS_ENABLED).
 * Allowed placements only: after the reading, between profile sections,
 * desktop rail. Never above the reading, inside a topic, forms, popups or sticky.
 * Props: placement "afterReading" | "inContent" | "rail"
 */
import { FEATURES } from "../config/site";
interface Props { placement: "afterReading" | "inContent" | "rail" }
const { placement } = Astro.props;
const height = placement === "rail" ? "h-ad-rail" : placement === "inContent" ? "h-ad-content" : "h-ad-mobile";
---
{FEATURES.ADS_ENABLED && (
  <aside class:list={["my-7 flex flex-col", height]} aria-label="Advertisement">
    <span class="text-small text-muted">Advertisement</span>
    <div class="mt-1 flex-1 border border-rule" data-ad-slot={FEATURES.AD_SLOTS[placement]}></div>
  </aside>
)}
