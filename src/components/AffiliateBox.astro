---
/**
 * AffiliateBox (§6.12): quiet bordered block, at most one image, short honest
 * description, one button, disclosure line. Max one per page. Off until
 * FEATURES.AFFILIATES_ENABLED. Props: title, text, href, store ("Etsy" | "Amazon" | string), image?
 */
import { FEATURES } from "../config/site";
interface Props { title: string; text: string; href: string; store: string; image?: string }
const { title, text, href, store, image } = Astro.props;
---
{FEATURES.AFFILIATES_ENABLED && (
  <aside class="my-7 flex gap-4 border border-rule p-5" aria-label="Recommended">
    {image && <img src={image} alt="" width="96" height="96" class="size-9 shrink-0 object-cover" loading="lazy" />}
    <div>
      <h2 class="text-h3">{title}</h2>
      <p class="mt-2">{text}</p>
      <a href={href} rel="sponsored nofollow noopener" target="_blank" class="btn-secondary mt-4">View on {store}</a>
      <p class="mt-3 text-small text-muted">We may earn a commission if you buy through this link, at no extra cost to you.</p>
    </div>
  </aside>
)}
