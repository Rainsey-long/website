---
/**
 * AlmanacCalendar (§6.8): Monday-first month grid, tabular numerals.
 * Each day: Gregorian number large, lunar day small. Good days carry the seal,
 * challenging days a small clay dot; today is outlined in cinnabar (set by
 * script from the visitor's local date). Selecting a day fills the detail
 * panel (good for / avoid / clash animal). Arrow keys move between days
 * (roving tabindex grid).
 * Props: year, month, days (AlmanacDay[])
 */
import Seal from "./Seal.astro";
import type { AlmanacDay } from "../lib/almanac";
import { fullDate } from "../lib/dates";
interface Props { year: number; month: number; days: AlmanacDay[] }
const { year, month, days } = Astro.props;
const firstDow = (new Date(Date.UTC(year, month - 1, 1)).getUTCDay() + 6) % 7; // Monday = 0
const cells: Array<AlmanacDay | null> = [...Array(firstDow).fill(null), ...days];
while (cells.length % 7) cells.push(null);
const weeks = Array.from({ length: cells.length / 7 }, (_, i) => cells.slice(i * 7, i * 7 + 7));
const DOW = [["Mon", "Monday"], ["Tue", "Tuesday"], ["Wed", "Wednesday"], ["Thu", "Thursday"], ["Fri", "Friday"], ["Sat", "Saturday"], ["Sun", "Sunday"]];
const qualityWord = { good: "Good day", neutral: "Ordinary day", challenging: "Challenging day" } as const;
const lunarShort = (d: AlmanacDay) => (d.lunarDay === 1 ? `${d.leapMonth ? "L" : ""}M${d.lunarMonth}` : String(d.lunarDay));
---
<div class="almanac">
  <table role="grid" class="w-full table-fixed border-collapse tabular" aria-labelledby="month-h">
    <thead>
      <tr>{DOW.map(([s, l]) => <th scope="col" class="py-2 text-small font-medium text-muted"><abbr title={l} class="no-underline">{s}</abbr></th>)}</tr>
    </thead>
    <tbody>
      {weeks.map((w) => (
        <tr>
          {w.map((d) => d ? (
            <td class="p-0 border-t border-rule" role="gridcell">
              <button type="button" class:list={["day", d.quality]} data-date={d.date} tabindex="-1"
                aria-label={`${fullDate(d.date)}, lunar ${d.lunarLabel}. ${qualityWord[d.quality]}.`}
                data-full={fullDate(d.date)} data-lunar={d.lunarLabel} data-pillar={d.dayPillar}
                data-good={JSON.stringify(d.good)} data-avoid={JSON.stringify(d.avoid)}
                data-clash={d.clash.name} data-clash-slug={d.clash.slug} data-quality={qualityWord[d.quality]}>
                <span class="num serif">{Number(d.date.slice(8))}</span>
                <span class="lunar text-small text-muted">{lunarShort(d)}</span>
                <span class="mark" aria-hidden="true">
                  {d.quality === "good" && <Seal size="sm" />}
                  {d.quality === "challenging" && <span class="dot"></span>}
                </span>
              </button>
            </td>
          ) : <td class="border-t border-rule" aria-hidden="true"></td>)}
        </tr>
      ))}
    </tbody>
  </table>

  <p class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-small text-muted">
    <span class="inline-flex items-center gap-2"><Seal size="sm" /> Good day</span>
    <span class="inline-flex items-center gap-2"><span class="dot"></span> Challenging day</span>
    <span class="inline-flex items-center gap-2"><span class="today-key"></span> Today</span>
  </p>

  <section id="day-detail" class="mt-6 border-y-2 border-ink py-5" aria-live="polite" aria-labelledby="detail-h">
    <h2 id="detail-h" class="text-h3" data-d="full">Pick a day</h2>
    <p class="mt-1 text-small text-muted" data-d="meta"></p>
    <dl class="mt-4 grid gap-5 sm:grid-cols-2">
      <div><dt class="font-semibold">Good for</dt><dd class="mt-1" data-d="good"></dd></div>
      <div><dt class="font-semibold">Avoid</dt><dd class="mt-1" data-d="avoid"></dd></div>
    </dl>
    <p class="mt-4" data-d="clash"></p>
  </section>
</div>

<style>
  .day {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-height: 64px;
    padding: 4px;
    text-align: left;
    background: transparent;
    color: var(--ink);
    border: 2px solid transparent;
    border-radius: 4px;
    cursor: pointer;
  }
  @media (min-width: 768px) { .day { min-height: 96px; padding: 8px; } }
  .day:hover { background: var(--paper-raised); }
  .day[aria-selected="true"] { background: var(--paper-raised); border-color: var(--ink); }
  .day.is-today { border-color: var(--cinnabar); }
  .num { font-size: var(--fs-h3); line-height: 1.1; }
  .mark { position: absolute; right: 4px; top: 4px; display: flex; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 9999px; background: var(--clay); }
  .today-key { display: inline-block; width: 16px; height: 16px; border: 2px solid var(--cinnabar); border-radius: 4px; }
  @media (max-width: 479px) { .lunar { font-size: var(--fs-small); } }
</style>

<script>
  import { localToday } from "../lib/client";
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".almanac .day")];
  const panel = document.getElementById("day-detail")!;
  const $ = (k: string) => panel.querySelector<HTMLElement>(`[data-d="${k}"]`)!;
  const list = (items: string[]) => (items.length ? items.join(", ") : "Nothing in particular");

  function select(btn: HTMLButtonElement, focus = false) {
    buttons.forEach((b) => { b.setAttribute("aria-selected", String(b === btn)); b.tabIndex = b === btn ? 0 : -1; });
    const d = btn.dataset;
    $("full").textContent = d.full!;
    $("meta").textContent = `Lunar ${d.lunar}. Day of ${d.pillar}. ${d.quality}.`;
    $("good").textContent = list(JSON.parse(d.good!));
    $("avoid").textContent = list(JSON.parse(d.avoid!));
    $("clash").replaceChildren("Clashes with the ", Object.assign(document.createElement("a"), { className: "link", href: `/chinese-zodiac/${d.clashSlug}/`, textContent: d.clash! }), ". People born in that year may prefer a quieter day.");
    if (focus) btn.focus();
    if (history.replaceState) history.replaceState(null, "", `#${d.date}`);
  }

  const today = localToday();
  const todayBtn = buttons.find((b) => b.dataset.date === today);
  todayBtn?.classList.add("is-today");
  todayBtn?.setAttribute("aria-current", "date");
  const fromHash = buttons.find((b) => `#${b.dataset.date}` === location.hash);
  select(fromHash ?? todayBtn ?? buttons[0]);

  buttons.forEach((b, i) => {
    b.addEventListener("click", () => select(b));
    b.addEventListener("keydown", (e) => {
      const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7, Home: -(i % 7), End: 6 - (i % 7) }[e.key];
      if (step === undefined) return;
      e.preventDefault();
      const next = buttons[Math.max(0, Math.min(buttons.length - 1, i + step))];
      select(next, true);
    });
  });
</script>
