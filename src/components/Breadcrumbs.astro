---
/** Breadcrumbs — visible trail; the JSON-LD copy is emitted by BaseLayout. Props: items [{name, href}], last item is the current page. */
interface Props { items: Array<{ name: string; href: string }> }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="mx-auto max-w-page safe-x pt-5">
  <ol class="flex flex-wrap gap-x-2 gap-y-1 text-small text-muted">
    <li><a class="link" href="/">Home</a></li>
    {items.map((c, i) => (
      <li class="flex gap-2">
        <span aria-hidden="true">/</span>
        {i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a class="link" href={c.href}>{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
