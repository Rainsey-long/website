---
/**
 * ChipGrid — SignPicker / AnimalPicker (§6.2). 12 chips, 4×3 mobile, 6×2 desktop.
 * Each chip: glyph, name, a small second line. Tap target ≥ 48×48px.
 * The chip matching the remembered sign gets the cinnabar ring (client script).
 * Props:
 *   items     [{slug, name, sub, href}]
 *   set       "western" | "animal"
 *   heading   section title (h2)
 *   headingId id for aria-labelledby
 *   remember  mark the remembered sign (western only)
 *   selected  slug to ring statically
 */
import Glyph from "./Glyph.astro";
interface Item { slug: string; name: string; sub: string; href: string }
interface Props { items: Item[]; set: "western" | "animal"; heading?: string; headingId?: string; remember?: boolean; selected?: string }
const { items, set, heading, headingId = `chips-${set}`, remember = false, selected } = Astro.props;
---
<section aria-labelledby={heading ? headingId : undefined}>
  {heading && <h2 id={headingId} class="text-h2">{heading}</h2>}
  <ul class="chip-grid mt-5 grid grid-cols-4 gap-2 md:grid-cols-6 md:gap-3" data-remember={remember ? "" : undefined}>
    {items.map((it) => (
      <li>
        <a href={it.href} class:list={["chip", { "is-selected": selected === it.slug }]} data-slug={it.slug} aria-current={selected === it.slug ? "page" : undefined}>
          <Glyph name={it.slug} set={set} class="size-glyph-lg" />
          <span class="text-small font-semibold">{it.name}</span>
          <span class="chip-sub text-small tabular text-muted">{it.sub}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: var(--size-tap);
    padding: 12px 4px;
    border-radius: 4px;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid transparent;
  }
  .chip:hover { border-color: var(--rule); background: var(--paper-raised); }
  .chip:hover .text-small { text-decoration: underline; text-underline-offset: 3px; }
  .chip.is-selected { border: 2px solid var(--cinnabar); }
  @media (max-width: 479px) { .chip-sub { display: none; } }
</style>

<script>
  import { readStore, MY_SIGN_KEY } from "../lib/client";
  const mark = () => {
    const mine = readStore(MY_SIGN_KEY);
    document.querySelectorAll<HTMLElement>("[data-remember] .chip").forEach((c) => {
      if (c.getAttribute("aria-current") === "page") return;
      c.classList.toggle("is-selected", !!mine && c.dataset.slug === mine);
    });
  };
  mark();
  window.addEventListener("mysign:change", mark);
</script>
