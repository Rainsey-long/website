---
/**
 * DayDial — the signature element (DESIGN_SYSTEM.md §6.1).
 * A circular sky chart: the 12-sign wheel in fine ink, brass ticks, and
 * markers for today's Moon (phase-accurate) and Sun. Data from sky.ts;
 * static SVG at build time. The only automatic motion on the site is the
 * Moon marker easing into position once (600ms), off under reduced motion.
 * Props:
 *   sky        SkyDay from skyForDay()
 *   selected   sign slug to ring in cinnabar (optional)
 *   tone       "night" (on the homepage night band) | "paper"
 *   size       "large" (280/360px) | "small" (200/240px)
 *   caption    show the plain-text line under the dial (default true)
 *   linkSigns  each sign navigates to its reading (default true)
 */
import { SIGNS } from "../lib/western";
import type { SkyDay } from "../lib/sky";
import { WESTERN_GLYPHS } from "../icons/glyphs";

interface Props { sky: SkyDay; selected?: string; tone?: "night" | "paper"; size?: "large" | "small"; caption?: boolean; linkSigns?: boolean; id?: string }
const { sky, selected, tone = "paper", size = "large", caption = true, linkSigns = true, id = "daydial" } = Astro.props;

const C = 200; // viewBox centre; viewBox is 400 × 400
const R_OUT = 190, R_SIGN_OUT = 186, R_SIGN_IN = 142, R_GLYPH = 164, R_TICK_IN = 132, R_MOON = 112, R_SUN = 82;
const D = Math.PI / 180;
/** Astrological convention: 0° Aries on the left, longitudes counter-clockwise. */
const pt = (lon: number, r: number) => ({ x: C - r * Math.cos(lon * D), y: C + r * Math.sin(lon * D) });
const f = (n: number) => Math.round(n * 100) / 100;

const ticks = Array.from({ length: 72 }, (_, i) => {
  const lon = i * 5;
  const major = lon % 30 === 0;
  const a = pt(lon, R_TICK_IN);
  const b = pt(lon, major ? R_SIGN_OUT : R_TICK_IN + 6);
  return { a, b, major };
});

function wedge(i: number) {
  const s = i * 30, e = s + 30;
  const p1 = pt(s, R_SIGN_IN), p2 = pt(s, R_SIGN_OUT), p3 = pt(e, R_SIGN_OUT), p4 = pt(e, R_SIGN_IN);
  // Counter-clockwise on screen as longitude grows → sweep-flag 0 on the outer arc.
  return `M${f(p1.x)} ${f(p1.y)}L${f(p2.x)} ${f(p2.y)}A${R_SIGN_OUT} ${R_SIGN_OUT} 0 0 0 ${f(p3.x)} ${f(p3.y)}L${f(p4.x)} ${f(p4.y)}A${R_SIGN_IN} ${R_SIGN_IN} 0 0 1 ${f(p1.x)} ${f(p1.y)}Z`;
}

const signs = SIGNS.map((s) => {
  const g = pt(s.index * 30 + 15, R_GLYPH);
  return { ...s, gx: g.x, gy: g.y, wedge: wedge(s.index) };
});

// Moon: drawn at angle 0 (left) then rotated into place, so the load easing is a rotation.
const moonLon = sky.moon.longitude;
const moonPos = pt(0, R_MOON);
const MR = 13;
const angle = sky.moon.phaseAngle;
const waxing = angle < 180;
const rx = f(MR * Math.abs(Math.cos(angle * D)));
const gibbous = angle > 90 && angle < 270;
let litPath = "";
if (sky.moon.phaseGroup === "full") litPath = "full";
else if (sky.moon.phaseGroup !== "new") {
  const top = `${f(moonPos.x)} ${f(moonPos.y - MR)}`;
  const bottom = `${f(moonPos.x)} ${f(moonPos.y + MR)}`;
  // Waxing: right limb lit (northern-hemisphere view); waning: left limb lit.
  litPath = waxing
    ? `M${top}A${MR} ${MR} 0 0 1 ${bottom}A${rx} ${MR} 0 0 ${gibbous ? 1 : 0} ${top}Z`
    : `M${top}A${MR} ${MR} 0 0 0 ${bottom}A${rx} ${MR} 0 0 ${gibbous ? 0 : 1} ${top}Z`;
}
// SVG rotate() is clockwise on screen; our longitudes run counter-clockwise.
const moonRotation = -moonLon;

const sun = pt(sky.sunLongitude, R_SUN);
const moonSign = SIGNS[sky.moon.signIndex];
const sentence = `The Moon is in ${moonSign.name} today, ${sky.moon.phaseName === "full moon" || sky.moon.phaseName === "new moon" ? `a ${sky.moon.phaseName}` : sky.moon.phaseName}.`;
const sunSign = SIGNS[sky.sunSignIndex];
const describe = `${sentence} The Sun is in ${sunSign.name}.`;
const dim = size === "large" ? "size-dial" : "size-dial-small";
---
<figure class:list={["daydial", `tone-${tone}`, "flex flex-col items-center"]}>
  <svg viewBox="0 0 400 400" class={dim} role="group" aria-labelledby={`${id}-cap`}>
    <circle cx={C} cy={C} r={R_OUT} class="ring" />
    <circle cx={C} cy={C} r={R_SIGN_OUT} class="ring-fine" />
    <circle cx={C} cy={C} r={R_SIGN_IN} class="ring" />
    <circle cx={C} cy={C} r={R_TICK_IN} class="ring-fine" />
    <circle cx={C} cy={C} r={R_SUN - 18} class="ring-fine" />
    {ticks.map((t) => <line x1={f(t.a.x)} y1={f(t.a.y)} x2={f(t.b.x)} y2={f(t.b.y)} class={t.major ? "tick-major" : "tick"} />)}

    {signs.map((s) => {
      const body = (
        <>
          <path d={s.wedge} class="wedge" />
          {selected === s.slug && <circle cx={f(s.gx)} cy={f(s.gy)} r="19" class="selected" />}
          <g transform={`translate(${f(s.gx - 12)} ${f(s.gy - 12)})`} class="glyph">
            {WESTERN_GLYPHS[s.slug].map(([tag, attrs]) =>
              tag === "path" ? <path {...attrs} /> : tag === "circle" ? <circle {...attrs} /> : <ellipse {...attrs} />
            )}
          </g>
        </>
      );
      return linkSigns
        ? <a href={`/horoscope/${s.slug}/`} aria-label={`${s.name} daily horoscope`} class="sign-link">{body}</a>
        : <g>{body}</g>;
    })}

    <g class="sun" aria-hidden="true">
      <circle cx={f(sun.x)} cy={f(sun.y)} r="9" class="sun-disc" />
      <circle cx={f(sun.x)} cy={f(sun.y)} r="2" class="sun-dot" />
    </g>

    <g class="moon-orbit" style={`--to: ${f(moonRotation)}deg`} aria-hidden="true">
      <line x1={f(pt(0, R_TICK_IN).x)} y1={C} x2={f(moonPos.x - MR)} y2={C} class="moon-lead" />
      <g class="moon-body" style={`transform-origin: ${f(moonPos.x)}px ${f(moonPos.y)}px`}>
        <circle cx={f(moonPos.x)} cy={f(moonPos.y)} r={MR} class="moon-dark" />
        {litPath === "full"
          ? <circle cx={f(moonPos.x)} cy={f(moonPos.y)} r={MR} class="moon-lit" />
          : litPath && <path d={litPath} class="moon-lit" />}
        <circle cx={f(moonPos.x)} cy={f(moonPos.y)} r={MR} class="moon-edge" />
      </g>
    </g>
  </svg>
  {caption
    ? <figcaption id={`${id}-cap`} class="mt-4 max-w-reading text-center serif text-reading">{sentence}</figcaption>
    : <figcaption id={`${id}-cap`} class="sr-only">{describe}</figcaption>}
</figure>

<style>
  .daydial { --dial-ink: var(--ink); --dial-muted: var(--rule-strong); --dial-ring: var(--cinnabar); --dial-hover: var(--paper-raised); }
  .tone-night { --dial-ink: var(--night-ink); --dial-muted: var(--night-rule); --dial-ring: var(--cinnabar-on-night); --dial-hover: var(--night-rule); color: var(--night-ink); }
  svg { overflow: visible; }
  .ring { fill: none; stroke: var(--dial-ink); stroke-width: 1.25; }
  .ring-fine { fill: none; stroke: var(--dial-muted); stroke-width: 0.75; }
  .tick { stroke: var(--brass); stroke-width: 0.75; }
  .tick-major { stroke: var(--dial-ink); stroke-width: 1; }
  .wedge { fill: transparent; }
  .sign-link:hover .wedge, .sign-link:focus-visible .wedge { fill: var(--dial-hover); }
  .sign-link:focus-visible { outline: none; }
  .sign-link:focus-visible .wedge { stroke: var(--dial-ring); stroke-width: 2; }
  .glyph { fill: none; stroke: var(--dial-ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .selected { fill: none; stroke: var(--dial-ring); stroke-width: 2; }
  .sun-disc { fill: none; stroke: var(--brass); stroke-width: 1.5; }
  .sun-dot { fill: var(--brass); }
  .moon-dark { fill: var(--paper); }
  .tone-night .moon-dark { fill: var(--night); }
  .moon-lit { fill: var(--brass); }
  .moon-edge { fill: none; stroke: var(--brass); stroke-width: 1.5; }
  .moon-lead { stroke: var(--brass); stroke-width: 0.75; stroke-dasharray: 2 3; }
  .moon-orbit {
    transform-origin: 200px 200px;
    transform: rotate(var(--to));
    animation: moon-ease 600ms var(--ease-out) both;
  }
  /* Counter-rotate the Moon so its lit limb stays correctly oriented. */
  .moon-body {
    transform: rotate(calc(-1 * var(--to)));
    animation: moon-counter 600ms var(--ease-out) both;
  }
  @keyframes moon-ease { from { transform: rotate(calc(var(--to) + 50deg)); } to { transform: rotate(var(--to)); } }
  @keyframes moon-counter { from { transform: rotate(calc(-1 * var(--to) - 50deg)); } to { transform: rotate(calc(-1 * var(--to))); } }
  @media (prefers-reduced-motion: reduce) {
    .moon-orbit, .moon-body { animation: none; }
  }
</style>
