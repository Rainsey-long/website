---
/** EnergyMeter (§6.4): five circles, filled = rating 1–5. Text alternative "Energy 4 of 5". Props: value, label (default "Energy"). */
interface Props { value: number; label?: string }
const { value, label = "Energy" } = Astro.props;
const v = Math.max(0, Math.min(5, Math.round(value)));
---
<span role="img" aria-label={`${label} ${v} of 5`} class="inline-flex items-center gap-1">
  {Array.from({ length: 5 }, (_, i) => (
    <svg viewBox="0 0 12 12" class="meter-dot" aria-hidden="true">
      <circle cx="6" cy="6" r="4.75" class={i < v ? "on" : "off"} />
    </svg>
  ))}
</span>
<style>
  .meter-dot { width: 12px; height: 12px; }
  .on { fill: var(--ink); stroke: var(--ink); stroke-width: 1.5; }
  .off { fill: none; stroke: var(--rule-strong); stroke-width: 1.5; }
</style>
