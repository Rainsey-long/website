---
/** Faq — questions as native disclosure (keyboard accessible); FAQPage JSON-LD is emitted by the page. Props: items [{q, a}] */
import type { Faq } from "../lib/content";
interface Props { items: Faq[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section aria-labelledby="faq-h" class="mt-7 border-t border-rule pt-5">
    <h2 id="faq-h" class="text-h2">Questions</h2>
    <div class="mt-3">
      {items.map((f) => (
        <details class="border-b border-rule">
          <summary class="flex min-h-tap cursor-pointer items-center py-3 serif text-h3">{f.q}</summary>
          <p class="reading pb-4">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
<style>
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; margin-left: auto; padding-left: 16px; font-family: var(--font-sans); color: var(--ink-muted); }
  details[open] summary::after { content: "−"; }
</style>
