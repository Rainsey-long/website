---
/**
 * LuckyRow (§6.5): almanac-style strip — lucky colour (swatch + name),
 * lucky number, lucky hour. On auspicious days the cinnabar seal appears
 * with "Good day for …".
 * Props: color {name, element}, number, hour, seal (string[] | null), heading
 */
import Seal from "./Seal.astro";
interface Props {
  color?: { name: string; element: "fire" | "earth" | "air" | "water" | "wood" };
  number?: number | string;
  hour?: string;
  seal?: string[] | null;
  heading?: string;
}
const { color, number, hour, seal, heading = "Lucky today" } = Astro.props;
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
---
<section aria-labelledby="lucky-h" class="border-y-2 border-ink py-5">
  <h2 id="lucky-h" class="text-h3">{heading}</h2>
  <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
    {color && (
      <div>
        <dt class="text-small text-muted">Colour</dt>
        <dd class="mt-1 flex items-center gap-2 font-semibold">
          <span class="swatch" style={`background: var(--el-${color.element})`} aria-hidden="true"></span>{color.name}
        </dd>
      </div>
    )}
    {number !== undefined && (
      <div>
        <dt class="text-small text-muted">Number</dt>
        <dd class="mt-1 serif text-h3 tabular">{number}</dd>
      </div>
    )}
    {hour && (
      <div>
        <dt class="text-small text-muted">Hour</dt>
        <dd class="mt-1 font-semibold tabular">{hour}</dd>
      </div>
    )}
  </dl>
  {seal && seal.length > 0 && (
    <p class="mt-5 flex items-center gap-3">
      <Seal />
      <span><span class="font-semibold">Good day for</span> {seal.map(lower).join(" and ")}.</span>
    </p>
  )}
</section>
<style>
  .swatch { display: inline-block; width: 16px; height: 16px; border-radius: 4px; }
</style>
