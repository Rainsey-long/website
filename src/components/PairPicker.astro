---
/**
 * PairPicker — "try another pair" form (wireframe §7.4). Two native selects;
 * submitting navigates to the canonical pair page. Works without JS via the
 * checker page fallback. Props: set, base ("/compatibility/" | "/chinese-compatibility/"), a, b
 */
interface Opt { slug: string; name: string }
interface Props { options: Opt[]; base: string; a?: string; b?: string; heading?: string; noun: string }
const { options, base, a, b, heading = "Try another pair", noun } = Astro.props;
const id = base.replace(/\W/g, "");
---
<form class="pair-picker mt-7 border-t border-rule pt-5" data-base={base} action="/tools/compatibility-checker/" method="get">
  <h2 class="text-h3">{heading}</h2>
  <div class="mt-4 grid gap-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
    <div>
      <label class="label" for={`${id}-a`}>First {noun}</label>
      <select class="field" id={`${id}-a`} name="a">{options.map((o) => <option value={o.slug} selected={o.slug === a}>{o.name}</option>)}</select>
    </div>
    <div>
      <label class="label" for={`${id}-b`}>Second {noun}</label>
      <select class="field" id={`${id}-b`} name="b">{options.map((o) => <option value={o.slug} selected={o.slug === b}>{o.name}</option>)}</select>
    </div>
    <input type="hidden" name="type" value={base.includes("chinese") ? "chinese" : "western"} />
    <button class="btn-primary" type="submit">Check compatibility</button>
  </div>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>(".pair-picker").forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const [x, y] = [String(fd.get("a")), String(fd.get("b"))].sort();
      location.href = `${form.dataset.base}${x}-and-${y}/`;
    });
  });
</script>
