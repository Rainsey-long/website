---
/** RelatedLinks — a proper link list (wireframe §7.2 "Related"). Props: heading, links [{href, label}] */
interface Props { heading?: string; links: Array<{ href: string; label: string }> }
const { heading = "Related", links } = Astro.props;
---
<nav aria-labelledby="related-h" class="mt-7 border-t border-rule pt-5">
  <h2 id="related-h" class="text-h3">{heading}</h2>
  <ul class="mt-3 flex flex-col gap-1">
    {links.map((l) => <li><a class="link inline-flex min-h-tap items-center" href={l.href}>{l.label}</a></li>)}
  </ul>
</nav>
