---
/** ReportOffer — paid report promo in the AffiliateBox pattern (§6.12, plan §11). Off until FEATURES.REPORT_CTA_ENABLED. Props: title, text */
import { FEATURES } from "../config/site";
interface Props { title: string; text: string }
const { title, text } = Astro.props;
---
{FEATURES.REPORT_CTA_ENABLED && (
  <aside class="my-7 border border-rule p-5" aria-label="Full report">
    <h2 class="text-h3">{title}</h2>
    <p class="mt-2">{text}</p>
    <a href={FEATURES.REPORT_URL} rel="noopener" class="btn-secondary mt-4">Get the full report</a>
    <p class="mt-3 text-small text-muted">A paid PDF, sold through our store. The free reading above stays free.</p>
  </aside>
)}
