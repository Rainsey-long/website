---
/** SaveSign — "Make Scorpio my sign" (§8.1). Stores the slug in localStorage and shows a toast. Props: slug, name */
interface Props { slug: string; name: string }
const { slug, name } = Astro.props;
---
<button type="button" class="btn-secondary" data-save-sign={slug} data-name={name}>Make {name} my sign</button>
<script>
  import { readStore, writeStore, toast, MY_SIGN_KEY } from "../lib/client";
  document.querySelectorAll<HTMLButtonElement>("[data-save-sign]").forEach((btn) => {
    const slug = btn.dataset.saveSign!;
    const name = btn.dataset.name!;
    const sync = () => {
      const mine = readStore(MY_SIGN_KEY) === slug;
      btn.hidden = mine;
    };
    sync();
    btn.addEventListener("click", () => {
      writeStore(MY_SIGN_KEY, slug);
      window.dispatchEvent(new Event("mysign:change"));
      toast(`Sign saved: ${name}`);
      sync();
    });
    window.addEventListener("mysign:change", sync);
  });
</script>
