---
/**
 * Share (§6.13): native Web Share on mobile; fallback copy link, Facebook, X,
 * Telegram, WhatsApp. Props: title, text, url (absolute)
 */
import Glyph from "./Glyph.astro";
interface Props { title: string; text: string; url: string }
const { title, text, url } = Astro.props;
const enc = encodeURIComponent;
const links = [
  ["Facebook", `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`],
  ["X", `https://x.com/intent/post?text=${enc(text)}&url=${enc(url)}`],
  ["Telegram", `https://t.me/share/url?url=${enc(url)}&text=${enc(text)}`],
  ["WhatsApp", `https://wa.me/?text=${enc(`${text} ${url}`)}`],
];
---
<section class="share mt-6" aria-labelledby="share-h" data-title={title} data-text={text} data-url={url}>
  <h2 id="share-h" class="sr-only">Share</h2>
  <div class="flex flex-wrap items-center gap-3">
    <button type="button" class="btn-secondary" data-native-share hidden>
      <Glyph name="share" set="ui" class="size-5" />Share
    </button>
    <button type="button" class="btn-secondary" data-copy-link>
      <Glyph name="link" set="ui" class="size-5" />Copy link
    </button>
    <ul class="flex flex-wrap gap-x-4 gap-y-2 text-small" data-share-fallback>
      {links.map(([name, href]) => (
        <li><a class="link inline-flex min-h-tap items-center" href={href} target="_blank" rel="noopener">Share on {name}</a></li>
      ))}
    </ul>
  </div>
</section>
<script>
  import { toast } from "../lib/client";
  document.querySelectorAll<HTMLElement>(".share").forEach((root) => {
    const { title = "", text = "", url = location.href } = root.dataset;
    const native = root.querySelector<HTMLButtonElement>("[data-native-share]")!;
    if (typeof navigator.share === "function" && matchMedia("(pointer: coarse)").matches) {
      native.hidden = false;
      root.querySelector<HTMLElement>("[data-share-fallback]")!.hidden = true;
      native.addEventListener("click", () => navigator.share({ title, text, url }).catch(() => {}));
    }
    root.querySelector("[data-copy-link]")!.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(url); toast("Link copied"); }
      catch { toast("Copy failed. Select the address bar to copy the link."); }
    });
  });
</script>
