---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChipGrid from "../components/ChipGrid.astro";
import { signChips } from "../lib/pages";
---
<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <div class="mx-auto max-w-page safe-x py-7">
    <h1 class="text-h1">This page doesn't exist. Pick your sign below.</h1>
    <p class="mt-3 text-muted" data-old-reading hidden>That daily reading has moved out of our archive. You'll find today's reading on the sign's page.</p>
    <div class="mt-6"><ChipGrid items={signChips()} set="western" remember /></div>
  </div>
</BaseLayout>
<script>
  // Dated readings outside the rolling window: send visitors to the sign hub (plan §10).
  const m = location.pathname.match(/^\/horoscope\/([a-z]+)\/\d{4}-\d{2}-\d{2}\/?$/);
  if (m) {
    document.querySelector<HTMLElement>("[data-old-reading]")!.hidden = false;
    location.replace(`/horoscope/${m[1]}/`);
  }
</script>
