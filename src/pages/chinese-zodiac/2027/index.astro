---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Glyph from "../../../components/Glyph.astro";
import EnergyMeter from "../../../components/EnergyMeter.astro";
import { ANIMALS } from "../../../lib/chinese";
import { yearlyForecast } from "../../../lib/content";
---
<BaseLayout title="2027 Year of the Fire Goat forecasts" description="What the 2027 Year of the Fire Goat may bring for each Chinese zodiac animal: love, career, money and month-by-month highlights." breadcrumbs={[{ name: "Chinese zodiac", href: "/chinese-zodiac/" }, { name: "2027", href: "/chinese-zodiac/2027/" }]}>
  <div class="mx-auto max-w-page safe-x py-6">
    <h1 class="text-h1">2027, the Year of the Fire Goat</h1>
    <p class="reading mt-3">The Fire Goat year begins at Lunar New Year on 6 February 2027 and runs until 25 January 2028. Fire brings warmth and visibility; the Goat brings gentleness, creativity and care for home.</p>
    <ul class="mt-6">
      {ANIMALS.map((a) => {
        const f = yearlyForecast(a.slug)?.frontmatter;
        return (
          <li class="border-t border-rule py-4">
            <a href={`/chinese-zodiac/${a.slug}/2027/`} class="group flex items-center gap-4 no-underline">
              <Glyph name={a.slug} set="animal" class="size-glyph-lg shrink-0" />
              <span class="flex-1">
                <span class="serif text-h3 group-hover:underline">{a.name} in 2027</span>
                {f?.summary && <span class="mt-1 block text-muted">{f.summary}</span>}
              </span>
              {f?.outlook && <EnergyMeter value={f.outlook} label="Outlook" />}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>
