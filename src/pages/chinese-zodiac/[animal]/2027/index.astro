---
/** Yearly forecast (wireframe §7.5). */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Glyph from "../../../../components/Glyph.astro";
import Prose from "../../../../components/Prose.astro";
import EnergyMeter from "../../../../components/EnergyMeter.astro";
import AdSlot from "../../../../components/AdSlot.astro";
import ReportOffer from "../../../../components/ReportOffer.astro";
import Share from "../../../../components/Share.astro";
import RelatedLinks from "../../../../components/RelatedLinks.astro";
import { ANIMALS, animalBySlug } from "../../../../lib/chinese";
import { chineseScore, RELATION_NAME, pairSlug } from "../../../../lib/compatibility";
import { yearlyForecast, articleLd } from "../../../../lib/content";
import { SITE_URL } from "../../../../config/site";

export function getStaticPaths() {
  return ANIMALS.map((animal) => ({ params: { animal: animal.slug }, props: { animal } }));
}
const { animal } = Astro.props;
const forecast = yearlyForecast(animal.slug);
const fm = forecast?.frontmatter;
const goat = animalBySlug("goat")!;
const rel = chineseScore(animal, goat).relation;
const title = `${animal.name} in the year of the Fire Goat (2027)`;
const description = fm?.summary ?? `The 2027 Fire Goat year forecast for the ${animal.name}: love, career, money and month by month.`;
const url = new URL(`/chinese-zodiac/${animal.slug}/2027/`, SITE_URL).href;
const allies = ANIMALS.filter((o) => o.slug !== animal.slug && ["three-harmonies", "six-harmonies"].includes(chineseScore(animal, o).relation));
const Content = forecast?.Content;
---
<BaseLayout title={title} description={description} ogType="article" ogImage={`/og/animal-${animal.slug}.png`}
  breadcrumbs={[{ name: "Chinese zodiac", href: "/chinese-zodiac/" }, { name: "2027", href: "/chinese-zodiac/2027/" }, { name: animal.name, href: `/chinese-zodiac/${animal.slug}/2027/` }]}
  jsonLd={[articleLd({ headline: title, description, url })]}>
  <div class="mx-auto max-w-page safe-x py-5 lg:grid lg:grid-cols-[minmax(0,1fr)_var(--size-rail)] lg:gap-7">
    <article class="max-w-reading">
      <Glyph name={animal.slug} set="animal" class="size-9" label={animal.name} />
      <h1 class="mt-3 text-h1">{animal.name} in the year of the Fire Goat</h1>
      <p class="mt-2 text-small text-muted">6 February 2027 to 25 January 2028</p>
      <dl class="mt-5 flex flex-wrap gap-x-7 gap-y-3 border-y border-rule py-4 text-small">
        <div><dt class="text-muted">With the Goat</dt><dd class="mt-1 font-semibold">{animal.slug === "goat" ? "Your own year" : RELATION_NAME[rel]}</dd></div>
        {fm?.outlook && <div><dt class="text-muted">Overall outlook</dt><dd class="mt-1"><EnergyMeter value={fm.outlook} label="Outlook" /></dd></div>}
      </dl>
      <div class="mt-7">{Content ? <Prose><Content /></Prose> : <p class="reading">{description}</p>}</div>
      {fm?.months && (
        <section class="mt-7 border-t border-rule pt-5" aria-labelledby="months-h">
          <h2 id="months-h" class="text-h2">Month by month</h2>
          <ol class="mt-3">
            {fm.months.map((m) => (
              <li class="border-b border-rule py-4">
                <h3 class="text-h3">{m.label}</h3>
                <p class="reading mt-1">{m.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )}
      <AdSlot placement="afterReading" />
      <ReportOffer title={`Your full 2027 ${animal.name} report`} text="A longer, printable forecast with each month in detail." />
      <Share title={title} text={`What 2027 may bring for the ${animal.name}`} url={url} />
      <RelatedLinks heading="Related animals" links={[
        ...allies.map((o) => ({ href: `/chinese-zodiac/${o.slug}/2027/`, label: `${o.name} in 2027` })),
        { href: `/chinese-zodiac/${animal.slug}/`, label: `${animal.name} profile` },
        { href: `/chinese-compatibility/${pairSlug(animal.slug, "goat")}/`, label: `${animal.name} and Goat compatibility` },
        { href: "/chinese-zodiac/2027/", label: "All 2027 forecasts" },
      ]} />
    </article>
    <div class="hidden lg:block"><AdSlot placement="rail" /></div>
  </div>
</BaseLayout>
