---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Glyph from "../../../components/Glyph.astro";
import Prose from "../../../components/Prose.astro";
import Faq from "../../../components/Faq.astro";
import AdSlot from "../../../components/AdSlot.astro";
import AffiliateBox from "../../../components/AffiliateBox.astro";
import RelatedLinks from "../../../components/RelatedLinks.astro";
import { ANIMALS, ELEMENT_NAME, zodiacYear } from "../../../lib/chinese";
import { animalProfile, faqLd, articleLd } from "../../../lib/content";
import { chineseScore, RELATION_NAME, pairSlug } from "../../../lib/compatibility";
import { almanacDay } from "../../../lib/almanac";
import { buildToday } from "../../../lib/dates";
import { SITE_URL } from "../../../config/site";

export function getStaticPaths() {
  return ANIMALS.map((animal) => ({ params: { animal: animal.slug }, props: { animal } }));
}
const { animal } = Astro.props;
const profile = animalProfile(animal.slug);
const fm = profile?.frontmatter;
const title = `Year of the ${animal.name}: personality and years`;
const description = fm?.summary ?? `The ${animal.name} in the Chinese zodiac: personality, years, compatibility and lucky elements.`;
const url = new URL(`/chinese-zodiac/${animal.slug}/`, SITE_URL).href;
const years = Array.from({ length: 8 }, (_, i) => 1936 + animal.index + i * 12).map((y) => zodiacYear(y));
const matches = ANIMALS.map((o) => ({ o, s: chineseScore(animal, o) })).filter(({ o }) => o.slug !== animal.slug).sort((a, b) => b.s.score - a.s.score);
// Today for this animal: the day's clash animal and day branch (daily Chinese reading, light touch).
const today = almanacDay(buildToday());
const clashToday = today.clash.slug === animal.slug;
const Content = profile?.Content;
---
<BaseLayout title={title} description={description} ogType="article"
  breadcrumbs={[{ name: "Chinese zodiac", href: "/chinese-zodiac/" }, { name: animal.name, href: `/chinese-zodiac/${animal.slug}/` }]}
  jsonLd={[articleLd({ headline: `The ${animal.name} in the Chinese zodiac`, description, url }), ...faqLd(fm?.faq)]}>
  <div class="mx-auto max-w-page safe-x py-5 lg:grid lg:grid-cols-[minmax(0,1fr)_var(--size-rail)] lg:gap-7">
    <article class="max-w-reading">
      <h1 class="flex items-center gap-3 text-display"><Glyph name={animal.slug} set="animal" class="size-glyph-lg shrink-0" />{animal.name}</h1>
      <p class="mt-2 text-small text-muted"><span lang="zh">{animal.hanzi}</span> · {animal.yinYang === "yang" ? "Yang" : "Yin"} · fixed element {ELEMENT_NAME[animal.branchElement]}</p>
      <section class="mt-5 border-y border-rule py-4" aria-labelledby="years-h">
        <h2 id="years-h" class="text-small font-semibold text-muted" style="font-family: var(--font-sans)">{animal.name} years</h2>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 tabular">
          {years.map((z) => <li>{z.year} <span class="text-muted">{ELEMENT_NAME[z.element]}</span></li>)}
        </ul>
      </section>
      <section class="mt-5" aria-labelledby="today-h">
        <h2 id="today-h" class="text-h3">Today for the {animal.name}</h2>
        <p class="reading mt-2">
          {clashToday
            ? `The almanac marks today as a clash day for the ${animal.name}. Keep plans simple and give big decisions another day.`
            : chineseScore(animal, today.clash).relation === "clash"
              ? `Today clashes with the ${today.clash.name}, your opposite, which leaves you on calm ground. A good day to support someone who feels unsettled.`
              : `Today clashes with the ${today.clash.name}, not with you. The almanac favours ${today.good.slice(0, 2).map((s) => s.toLowerCase()).join(" and ") || "steady routines"}.`}
        </p>
        <p class="mt-2"><a class="link" href={`/lucky-days/${buildToday().slice(0, 4)}/${buildToday().slice(5, 7)}/`}>See this month's lucky days</a></p>
      </section>
      <p class="mt-5"><a class="btn-primary" href={`/chinese-zodiac/${animal.slug}/2027/`}>Read the {animal.name} 2027 forecast</a></p>
      <div class="mt-7">{Content ? <Prose><Content /></Prose> : <p class="reading">{description}</p>}</div>
      <AdSlot placement="inContent" />
      <section class="mt-7 border-t border-rule pt-5" aria-labelledby="matches-h">
        <h2 id="matches-h" class="text-h2">{animal.name} compatibility</h2>
        <ul class="mt-3">
          {matches.map(({ o, s }) => (
            <li class="flex justify-between gap-3 border-b border-rule py-3">
              <a class="link" href={`/chinese-compatibility/${pairSlug(animal.slug, o.slug)}/`}>{animal.name} and {o.name}</a>
              <span class="text-small text-muted">{RELATION_NAME[s.relation]} · <span class="tabular">{s.score}</span></span>
            </li>
          ))}
        </ul>
      </section>
      <Faq items={fm?.faq ?? []} />
      <AffiliateBox title={`Year of the ${animal.name} gifts`} text={`Small gifts inspired by the ${animal.name}.`} href="#" store="Etsy" />
      <RelatedLinks links={[
        { href: `/chinese-zodiac/${animal.slug}/2027/`, label: `${animal.name} in 2027` },
        { href: "/chinese-compatibility/", label: "Chinese compatibility for every pair" },
        { href: "/southeast-asian-zodiac/", label: "The zodiac in Cambodia and Vietnam" },
      ]} />
    </article>
    <div class="hidden lg:block"><AdSlot placement="rail" /></div>
  </div>
</BaseLayout>
