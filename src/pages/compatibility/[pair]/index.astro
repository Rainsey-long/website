---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CompatibilityResult from "../../../components/CompatibilityResult.astro";
import PairPicker from "../../../components/PairPicker.astro";
import RelatedLinks from "../../../components/RelatedLinks.astro";
import AdSlot from "../../../components/AdSlot.astro";
import AffiliateBox from "../../../components/AffiliateBox.astro";
import Share from "../../../components/Share.astro";
import { SIGNS } from "../../../lib/western";
import { westernScore, WESTERN_RELATION_NAME, pairSlug } from "../../../lib/compatibility";
import { westernCopy } from "../../../lib/compat-copy";
import { articleLd } from "../../../lib/content";
import { SITE_URL } from "../../../config/site";

export function getStaticPaths() {
  const out = [];
  for (const a of SIGNS) for (const b of SIGNS) if (a.slug <= b.slug) out.push({ params: { pair: pairSlug(a.slug, b.slug) }, props: { a, b } });
  return out;
}
const { a, b } = Astro.props;
const s = westernScore(a, b);
const copy = westernCopy(a, b, s.relation);
const relationName = WESTERN_RELATION_NAME[s.relation];
const title = `${a.name} and ${b.name} compatibility`;
const description = `${a.name} and ${b.name}: ${relationName.toLowerCase()}, ${s.score}% match. How these signs connect in love, friendship and work.`;
const url = new URL(`/compatibility/${pairSlug(a.slug, b.slug)}/`, SITE_URL).href;
const others = SIGNS.filter((x) => x.element === a.element && x.slug !== b.slug && x.slug !== a.slug).slice(0, 2);
---
<BaseLayout title={title} description={description} ogType="article"
  breadcrumbs={[{ name: "Compatibility", href: "/compatibility/" }, { name: `${a.name} and ${b.name}`, href: `/compatibility/${pairSlug(a.slug, b.slug)}/` }]}
  jsonLd={[articleLd({ headline: title, description, url })]}>
  <div class="mx-auto max-w-reading safe-x py-5 box-content">
    <CompatibilityResult a={a} b={b} set="western" relationName={relationName} score={s} title={title} />
    <div class="reading mt-6">
      <h2 class="text-h2">How these signs connect</h2>
      {copy.connect.map((p) => <p class="mt-3">{p}</p>)}
      <h2 class="mt-7 text-h2">Strengths</h2>
      <ul class="mt-3 list-disc pl-5">{copy.strengths.map((p) => <li class="mt-2">{p}</li>)}</ul>
      <AdSlot placement="inContent" />
      <h2 class="mt-7 text-h2">Challenges</h2>
      <ul class="mt-3 list-disc pl-5">{copy.challenges.map((p) => <li class="mt-2">{p}</li>)}</ul>
      <h2 class="mt-7 text-h2">Advice</h2>
      <ul class="mt-3 list-disc pl-5">{copy.advice.map((p) => <li class="mt-2">{p}</li>)}</ul>
    </div>
    <Share title={title} text={`${a.name} and ${b.name}: ${s.score}% match`} url={url} />
    <PairPicker options={SIGNS} base="/compatibility/" noun="sign" a={a.slug} b={b.slug} />
    <AffiliateBox title="Zodiac gifts" text="Small, well-made gifts for the signs in your life." href="#" store="Etsy" />
    <RelatedLinks heading="Related pairs and readings" links={[
      ...others.map((o) => ({ href: `/compatibility/${pairSlug(a.slug, o.slug)}/`, label: `${a.name} and ${o.name}` })),
      { href: `/horoscope/${a.slug}/`, label: `${a.name} horoscope today` },
      { href: `/horoscope/${b.slug}/`, label: `${b.name} horoscope today` },
      { href: `/zodiac/${a.slug}/`, label: `${a.name} profile` },
    ]} />
  </div>
</BaseLayout>
