---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PairPicker from "../../components/PairPicker.astro";
import Glyph from "../../components/Glyph.astro";
import { SIGNS } from "../../lib/western";
import { westernScore, pairSlug } from "../../lib/compatibility";
---
<BaseLayout title="Zodiac compatibility for every pair" description="Compatibility for all 78 Western zodiac pairings: love, friendship and work, explained by element and aspect." breadcrumbs={[{ name: "Compatibility", href: "/compatibility/" }]}>
  <div class="mx-auto max-w-page safe-x py-6">
    <h1 class="text-h1">Zodiac compatibility</h1>
    <p class="reading mt-3 text-muted">Pick two signs to see how they connect. Scores come from elements and the angle between signs on the wheel. For the Chinese animals, see <a class="link text-ink" href="/chinese-compatibility/">Chinese compatibility</a>.</p>
    <PairPicker options={SIGNS} base="/compatibility/" noun="sign" heading="Check two signs" a="aries" b="leo" />
    <div class="mt-7 grid gap-x-6 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {SIGNS.map((s) => (
        <section aria-labelledby={`c-${s.slug}`}>
          <h2 id={`c-${s.slug}`} class="flex items-center gap-2 text-h3"><Glyph name={s.slug} set="western" class="size-5" />{s.name}</h2>
          <ul class="mt-2">
            {SIGNS.map((o) => (
              <li class="flex justify-between border-b border-rule py-1">
                <a class="link inline-flex min-h-tap items-center" href={`/compatibility/${pairSlug(s.slug, o.slug)}/`}>{s.name} and {o.name}</a>
                <span class="tabular text-muted self-center">{westernScore(s, o).score}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
