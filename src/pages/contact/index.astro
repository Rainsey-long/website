---
import TextPage from "../../layouts/TextPage.astro";
import { CONTACT_EMAIL, SITE_NAME } from "../../config/site";
---
<TextPage title="Contact" path="/contact/" description={`How to contact ${SITE_NAME}.`}>
  <p>We read every message. For corrections, suggestions or partnership questions, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
  <p>We can't offer personal readings or advice by email.</p>
</TextPage>
