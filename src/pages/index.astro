---
import BaseLayout from "../layouts/BaseLayout.astro";
import DayDial from "../components/DayDial.astro";
import ChipGrid from "../components/ChipGrid.astro";
import LuckyRow from "../components/LuckyRow.astro";
import Glyph from "../components/Glyph.astro";
import { skyForDay } from "../lib/sky";
import { addDays, buildToday, longDate, fullDate } from "../lib/dates";
import { signChips, animalChips, generalLucky } from "../lib/pages";
import { readingsForDay } from "../lib/reading-engine";
import { chineseScore, westernScore, pairSlug } from "../lib/compatibility";
import { animalBySlug } from "../lib/chinese";
import { signBySlug } from "../lib/western";
import { SITE_NAME, SITE_TAGLINE } from "../config/site";

const today = buildToday();
const sky = skyForDay(today);
const lucky = generalLucky(today);

// Small summaries for the remembered sign, for yesterday/today/tomorrow so the
// visitor's local date always finds a match.
const summaries: Record<string, Record<string, { energy: number[]; line: string; date: string }>> = {};
for (const d of [addDays(today, -1), today, addDays(today, 1)]) {
  summaries[d] = {};
  for (const r of readingsForDay(d)) {
    summaries[d][r.sign.slug] = {
      energy: r.topics.map((t) => t.energy),
      line: r.topics[3].text.split(/(?<=\.)\s/)[0],
      date: fullDate(d),
    };
  }
}
const dateLabels = Object.fromEntries(Object.keys(summaries).map((d) => [d, longDate(d)]));

const westernPairs = [["aries", "leo"], ["taurus", "cancer"], ["gemini", "libra"], ["scorpio", "pisces"], ["virgo", "capricorn"], ["leo", "aquarius"]].map(([a, b]) => {
  const s = westernScore(signBySlug(a)!, signBySlug(b)!);
  return { href: `/compatibility/${pairSlug(a, b)}/`, label: `${signBySlug(a)!.name} and ${signBySlug(b)!.name}`, score: s.score };
});
const chinesePairs = [["rat", "dragon"], ["tiger", "horse"], ["rabbit", "goat"], ["dragon", "rooster"], ["horse", "goat"], ["rat", "ox"]].map(([a, b]) => {
  const s = chineseScore(animalBySlug(a)!, animalBySlug(b)!);
  return { href: `/chinese-compatibility/${pairSlug(a, b)}/`, label: `${animalBySlug(a)!.name} and ${animalBySlug(b)!.name}`, score: s.score };
});
const animalsByYear = animalChips(2027, (s) => `/chinese-zodiac/${s}/2027/`);
---
<BaseLayout title={SITE_TAGLINE} description="Free daily horoscopes for all 12 signs, Chinese zodiac profiles, the 2027 Fire Goat forecast, compatibility and lucky days, from real sky data.">
  <section id="my-reading" class="border-b border-rule" hidden aria-labelledby="my-reading-h">
    <div class="mx-auto max-w-page safe-x py-5">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="my-reading-h" class="text-h2">Your reading today</h2>
        <button type="button" class="link text-small min-h-tap" data-change-sign>Change sign</button>
      </div>
      <div class="mt-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="flex items-center gap-4">
          <span data-my-glyph class="text-ink"></span>
          <div>
            <p class="serif text-h3" data-my-name></p>
            <p class="text-small text-muted" data-my-date></p>
          </div>
        </div>
        <dl class="grid grid-cols-4 gap-4 text-small" data-my-meters></dl>
      </div>
      <p class="reading mt-4" data-my-line></p>
      <a class="btn-primary mt-4" href="#" data-my-link>Read today's horoscope</a>
    </div>
  </section>

  <section class="night-band" aria-labelledby="today-h">
    <div class="mx-auto flex max-w-page flex-col items-center safe-x py-7 md:py-8">
      <h1 class="sr-only">{SITE_NAME}: daily horoscopes, Chinese zodiac and lucky days</h1>
      <p id="today-h" class="serif text-h2 text-center" data-build-date={today}>
        <span data-today-prefix>Today, </span><time datetime={today}>{longDate(today)}</time>
      </p>
      <div class="mt-6"><DayDial sky={sky} tone="night" id="home-dial" /></div>
    </div>
  </section>

  <div class="mx-auto max-w-page safe-x">
    <div class="py-7">
      <ChipGrid items={signChips()} set="western" heading="Pick your sign" headingId="pick-sign" remember />
      <p class="mt-4"><a class="link" href="/tools/zodiac-calculator/">Find my sign</a></p>
    </div>

    <div class="border-t border-rule py-7">
      <ChipGrid items={animalChips()} set="animal" heading="Chinese zodiac" headingId="pick-animal" />
      <p class="mt-4 text-muted">Your animal comes from the year you were born, counted from Lunar New Year. <a class="link text-ink" href="/tools/zodiac-calculator/">Find your animal</a></p>
    </div>

    <div class="border-t border-rule py-7">
      <LuckyRow heading={`Today's almanac: ${lucky.almanac.lunarLabel}`} color={lucky.color} number={lucky.number} hour={lucky.hour} seal={lucky.seal} />
      <p class="mt-4 text-muted">Day of {lucky.almanac.dayPillar}. Clashes with the {lucky.almanac.clash.name}. <a class="link text-ink" href={`/lucky-days/${today.slice(0, 4)}/${today.slice(5, 7)}/`}>See this month's lucky days</a></p>
    </div>

    <section class="border-t border-rule py-7" aria-labelledby="goat-h">
      <h2 id="goat-h" class="text-h2">2027 Year of the Fire Goat</h2>
      <p class="reading mt-3">The Fire Goat year begins at Lunar New Year on 6 February 2027. Read what it may bring for your animal.</p>
      <ul class="mt-5 grid grid-cols-2 gap-x-5 gap-y-1 sm:grid-cols-3 md:grid-cols-4">
        {animalsByYear.map((a) => (
          <li><a class="link inline-flex min-h-tap items-center gap-2" href={a.href}><Glyph name={a.slug} set="animal" class="size-5" />{a.name}</a></li>
        ))}
      </ul>
    </section>

    <section class="border-t border-rule py-7" aria-labelledby="pairs-h">
      <h2 id="pairs-h" class="text-h2">Popular compatibility pairs</h2>
      <div class="mt-5 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="text-h3">Western signs</h3>
          <ul class="mt-3">
            {westernPairs.map((p) => <li class="flex justify-between border-b border-rule py-3"><a class="link" href={p.href}>{p.label}</a><span class="tabular text-muted">{p.score}</span></li>)}
          </ul>
        </div>
        <div>
          <h3 class="text-h3">Chinese animals</h3>
          <ul class="mt-3">
            {chinesePairs.map((p) => <li class="flex justify-between border-b border-rule py-3"><a class="link" href={p.href}>{p.label}</a><span class="tabular text-muted">{p.score}</span></li>)}
          </ul>
        </div>
      </div>
      <p class="mt-5"><a class="btn-secondary" href="/tools/compatibility-checker/">Check compatibility</a></p>
    </section>
  </div>

  <script type="application/json" id="home-data" set:html={JSON.stringify({ summaries, dateLabels, today })}></script>
</BaseLayout>

<style>
  .night-band { background: var(--night); color: var(--night-ink); }
  [hidden] { display: none !important; }
</style>

<script>
  import { readStore, writeStore, localToday, MY_SIGN_KEY } from "../lib/client";
  import { WESTERN_GLYPHS } from "../icons/glyphs";

  const data = JSON.parse(document.getElementById("home-data")!.textContent!);
  const local = localToday();

  // Honest date label: only say "Today" when the dial's date is the visitor's date.
  if (local !== data.today) {
    const prefix = document.querySelector<HTMLElement>("[data-today-prefix]");
    if (prefix) prefix.textContent = "Sky for ";
  }

  const NAMES: Record<string, string> = { aries: "Aries", taurus: "Taurus", gemini: "Gemini", cancer: "Cancer", leo: "Leo", virgo: "Virgo", libra: "Libra", scorpio: "Scorpio", sagittarius: "Sagittarius", capricorn: "Capricorn", aquarius: "Aquarius", pisces: "Pisces" };
  const TOPICS = ["Love", "Career", "Money", "Mood"];
  const SVG = "http://www.w3.org/2000/svg";

  function glyph(slug: string) {
    const svg = document.createElementNS(SVG, "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("class", "size-glyph-lg");
    svg.setAttribute("aria-hidden", "true");
    for (const [k, v] of Object.entries({ fill: "none", stroke: "currentColor", "stroke-width": "1.5", "stroke-linecap": "round", "stroke-linejoin": "round" })) svg.setAttribute(k, v);
    for (const [tag, attrs] of WESTERN_GLYPHS[slug] ?? []) {
      const el = document.createElementNS(SVG, tag);
      for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
      svg.append(el);
    }
    return svg;
  }

  function meter(value: number, label: string) {
    const wrap = document.createElement("div");
    const dt = document.createElement("dt");
    dt.className = "text-muted";
    dt.textContent = label;
    const dd = document.createElement("dd");
    dd.setAttribute("role", "img");
    dd.setAttribute("aria-label", `${label} energy ${value} of 5`);
    dd.className = "mt-1 flex gap-1";
    for (let i = 0; i < 5; i++) {
      const dot = document.createElement("span");
      dot.className = i < value ? "dot on" : "dot";
      dd.append(dot);
    }
    wrap.append(dt, dd);
    return wrap;
  }

  function render() {
    const section = document.getElementById("my-reading")!;
    const sign = readStore(MY_SIGN_KEY);
    const day = data.summaries[local] ?? data.summaries[data.today];
    const s = sign && day?.[sign];
    if (!sign || !s) { section.hidden = true; return; }
    section.querySelector("[data-my-glyph]")!.replaceChildren(glyph(sign));
    section.querySelector("[data-my-name]")!.textContent = NAMES[sign];
    section.querySelector("[data-my-date]")!.textContent = s.date;
    section.querySelector("[data-my-meters]")!.replaceChildren(...s.energy.map((v: number, i: number) => meter(v, TOPICS[i])));
    section.querySelector("[data-my-line]")!.textContent = s.line;
    const link = section.querySelector<HTMLAnchorElement>("[data-my-link]")!;
    link.href = `/horoscope/${sign}/`;
    link.textContent = `Read today's ${NAMES[sign]} horoscope`;
    section.hidden = false;
  }
  render();

  document.querySelector("[data-change-sign]")!.addEventListener("click", () => {
    writeStore(MY_SIGN_KEY, null);
    window.dispatchEvent(new Event("mysign:change"));
    render();
    document.getElementById("pick-sign")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  });
</script>

<style is:global>
  #my-reading .dot { width: 12px; height: 12px; border-radius: 9999px; border: 1.5px solid var(--rule-strong); display: inline-block; }
  #my-reading .dot.on { background: var(--ink); border-color: var(--ink); }
</style>
