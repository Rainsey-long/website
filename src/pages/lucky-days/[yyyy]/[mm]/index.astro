---
/** Lucky days month (wireframe §7.6). */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AlmanacCalendar from "../../../../components/AlmanacCalendar.astro";
import Glyph from "../../../../components/Glyph.astro";
import { almanacDay } from "../../../../lib/almanac";
import { monthName } from "../../../../lib/dates";
import { ALMANAC_YEARS } from "../../../../config/site";

export function getStaticPaths() {
  const months = ALMANAC_YEARS.flatMap((y) => Array.from({ length: 12 }, (_, i) => ({ y, m: i + 1 })));
  return months.map(({ y, m }, i) => ({
    params: { yyyy: String(y), mm: String(m).padStart(2, "0") },
    props: { year: y, month: m, prev: months[i - 1] ?? null, next: months[i + 1] ?? null },
  }));
}
const { year, month, prev, next } = Astro.props;
const count = new Date(Date.UTC(year, month, 0)).getUTCDate();
const days = Array.from({ length: count }, (_, i) => almanacDay(`${year}-${String(month).padStart(2, "0")}-${String(i + 1).padStart(2, "0")}`));
const good = days.filter((d) => d.quality === "good").length;
const label = `${monthName(month)} ${year}`;
const href = (p: { y: number; m: number }) => `/lucky-days/${p.y}/${String(p.m).padStart(2, "0")}/`;
---
<BaseLayout title={`Lucky days in ${label}`} description={`Auspicious and challenging days for ${label} from the traditional Chinese almanac: what each day is good for, what to avoid, and the clash animal.`}
  breadcrumbs={[{ name: "Lucky days", href: "/lucky-days/" }, { name: label, href: href({ y: year, m: month }) }]}>
  <div class="mx-auto max-w-page safe-x py-5">
    <nav aria-label="Month" class="flex justify-between text-small">
      {prev ? <a class="link inline-flex min-h-tap items-center gap-1" href={href(prev)} rel="prev"><Glyph name="chevron-left" set="ui" class="size-4" />{monthName(prev.m)} {prev.y}</a> : <span></span>}
      {next ? <a class="link inline-flex min-h-tap items-center gap-1" href={href(next)} rel="next">{monthName(next.m)} {next.y}<Glyph name="chevron-right" set="ui" class="size-4" /></a> : <span></span>}
    </nav>
    <h1 id="month-h" class="mt-3 text-h1">Lucky days in {label}</h1>
    <p class="mt-2 text-muted">{good} good days this month by the traditional almanac.</p>
    <div class="mt-6 lg:grid lg:grid-cols-[minmax(0,1fr)_var(--size-rail)] lg:gap-7">
      <AlmanacCalendar year={year} month={month} days={days} />
      <aside class="mt-7 lg:mt-0">
        <h2 class="text-h3">How the almanac works</h2>
        <div class="reading mt-3 text-body">
          <p>The Chinese almanac, the tong shu, has guided everyday plans for centuries. Each day carries a pair of characters from the sixty-day cycle, a day spirit and a day officer.</p>
          <p>Days ruled by a favourable spirit are marked with the seal. Days whose spirit and officer both lean unfavourable get a small dot. The lists of what a day suits come straight from the almanac's tradition.</p>
          <p>The clash animal is the zodiac animal opposite the day's branch. People born in that year may prefer to keep big plans for another day.</p>
          <p class="text-small text-muted">A tradition to enjoy and reflect on, not a rule. Medical and catch-all entries are left out.</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
