---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ALMANAC_YEARS } from "../../config/site";
import { monthName, buildToday } from "../../lib/dates";
const today = buildToday();
const current = `/lucky-days/${today.slice(0, 4)}/${today.slice(5, 7)}/`;
---
<BaseLayout title="Lucky days calendar" description="Good days and days to take care, month by month, from the traditional Chinese almanac." breadcrumbs={[{ name: "Lucky days", href: "/lucky-days/" }]}>
  <div class="mx-auto max-w-page safe-x py-6">
    <h1 class="text-h1">Lucky days</h1>
    <p class="reading mt-3 text-muted">Each month's calendar shows the almanac's good days, what each day suits, and the animal it clashes with.</p>
    <p class="mt-5"><a class="btn-primary" href={current} data-this-month>See this month</a></p>
    {ALMANAC_YEARS.map((y) => (
      <section class="mt-7 border-t border-rule pt-5" aria-labelledby={`y-${y}`}>
        <h2 id={`y-${y}`} class="text-h2 tabular">{y}</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-5 sm:grid-cols-3 md:grid-cols-4">
          {Array.from({ length: 12 }, (_, i) => <li><a class="link inline-flex min-h-tap items-center" href={`/lucky-days/${y}/${String(i + 1).padStart(2, "0")}/`}>{monthName(i + 1)}</a></li>)}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
<script>
  import { localToday } from "../../lib/client";
  const t = localToday();
  const a = document.querySelector<HTMLAnchorElement>("[data-this-month]")!;
  a.href = `/lucky-days/${t.slice(0, 4)}/${t.slice(5, 7)}/`;
</script>
