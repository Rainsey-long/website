---
/**
 * /styleguide (DESIGN_SYSTEM.md §10.3): every token and component, in light
 * and dark side by side. noindex and excluded from the sitemap. Update it
 * whenever a component changes.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Glyph from "../../components/Glyph.astro";
import EnergyMeter from "../../components/EnergyMeter.astro";
import Seal from "../../components/Seal.astro";
import LuckyRow from "../../components/LuckyRow.astro";
import DayDial from "../../components/DayDial.astro";
import ChipGrid from "../../components/ChipGrid.astro";
import ReadingSection from "../../components/ReadingSection.astro";
import CompatibilityResult from "../../components/CompatibilityResult.astro";
import { SIGNS } from "../../lib/western";
import { ANIMALS, animalBySlug } from "../../lib/chinese";
import { dailyReading } from "../../lib/reading-engine";
import { skyForDay } from "../../lib/sky";
import { chineseScore, RELATION_NAME } from "../../lib/compatibility";
import { signChips } from "../../lib/pages";
import { buildToday } from "../../lib/dates";

const today = buildToday();
const sky = skyForDay(today);
const reading = dailyReading(SIGNS[7], today, sky);
const rat = animalBySlug("rat")!, dragon = animalBySlug("dragon")!;
const cs = chineseScore(rat, dragon);
const colors = ["paper", "paper-raised", "ink", "ink-muted", "rule", "rule-strong", "cinnabar", "on-accent", "night", "brass", "jade", "clay", "el-fire", "el-earth", "el-air", "el-water", "el-wood"];
const type = [["display", "Scorpio"], ["h1", "Page title"], ["h2", "Section title"], ["h3", "Topic title"], ["reading", "Reading text sits in Newsreader with generous leading."], ["body", "UI copy in Figtree."], ["small", "Captions and metadata."]];
const spaces = [0, 4, 8, 12, 16, 24, 32, 48, 64, 96, 128];
---
<BaseLayout title="Styleguide" description="Design tokens and components." noindex>
  <div class="mx-auto max-w-page safe-x py-6">
    <h1 class="text-h1">Styleguide</h1>
    <p class="mt-2 text-muted">Source of truth: DESIGN_SYSTEM.md. Left column light, right column dark.</p>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      {["theme-light", "theme-dark"].map((theme) => (
        <div class={`${theme} bg-paper p-5 text-ink`}>
          <h2 class="text-h2">{theme === "theme-light" ? "Light" : "Dark"}</h2>

          <h3 class="mt-6 text-h3">Colour tokens</h3>
          <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
            {colors.map((c) => (
              <li class="flex items-center gap-2 text-small">
                <span class="swatch" style={`background: var(--${c})`}></span>{c}
              </li>
            ))}
          </ul>

          <h3 class="mt-6 text-h3">Type scale</h3>
          {type.map(([t, sample]) => (
            <p class={t === "reading" ? "reading mt-3" : `mt-3 text-${t} ${["display", "h1", "h2", "h3"].includes(t) ? "serif" : ""}`}>
              <span class="block text-small text-muted" style="font-family: var(--font-sans)">{t}</span>{sample}
            </p>
          ))}

          <h3 class="mt-6 text-h3">Buttons, links, fields</h3>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <button class="btn-primary" type="button">Show my signs</button>
            <button class="btn-secondary" type="button">Read tomorrow</button>
            <a class="link" href="#">Text link</a>
          </div>
          <label class="label mt-4" for={`f-${theme}`}>Birth date</label>
          <input class="field" type="date" id={`f-${theme}`} />
          <label class="label mt-3" for={`e-${theme}`}>With an error</label>
          <input class="field" id={`e-${theme}`} aria-invalid="true" value="31/02/1990" />
          <p class="mt-2 text-small font-semibold text-cinnabar">Enter a date between 1900 and today.</p>

          <h3 class="mt-6 text-h3">Energy meter, seal</h3>
          <div class="mt-3 flex flex-wrap items-center gap-5"><EnergyMeter value={1} /><EnergyMeter value={3} /><EnergyMeter value={5} /><Seal /><Seal size="sm" /></div>

          <h3 class="mt-6 text-h3">Glyphs</h3>
          <div class="mt-3 flex flex-wrap gap-3">{SIGNS.map((s) => <Glyph name={s.slug} set="western" label={s.name} class="size-glyph-lg" />)}</div>
          <div class="mt-3 flex flex-wrap gap-3">{ANIMALS.map((a) => <Glyph name={a.slug} set="animal" label={a.name} class="size-glyph-lg" />)}</div>
          <div class="mt-3 flex flex-wrap gap-3">{["menu", "close", "sun", "moon", "chevron-left", "chevron-right", "share", "link"].map((n) => <Glyph name={n} set="ui" label={n} />)}</div>

          <h3 class="mt-6 text-h3">Lucky row</h3>
          <div class="mt-3"><LuckyRow color={reading.lucky.color} number={reading.lucky.number} hour={reading.lucky.hour} seal={["Travel", "Signing contracts"]} /></div>
        </div>
      ))}
    </div>

    <section class="mt-8">
      <h2 class="text-h2">Spacing and radius</h2>
      <ul class="mt-4 flex flex-col gap-2">
        {spaces.map((s, i) => <li class="flex items-center gap-4 text-small tabular"><span class="w-9">space-{i}</span><span class="h-3 bg-ink" style={`width:${s}px`}></span>{s}px</li>)}
      </ul>
      <div class="mt-5 flex gap-5 text-small"><span class="inline-flex size-8 items-center justify-center rounded-sm border border-ink">sm 4px</span><span class="inline-flex size-8 items-center justify-center rounded-full border border-ink">full</span><span class="inline-flex size-8 items-center justify-center bg-raised shadow-lift">shadow-lift</span></div>
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="night-band p-5"><h2 class="text-h2 text-night-ink">DayDial on night</h2><div class="mt-4"><DayDial sky={sky} tone="night" selected="scorpio" id="sg-1" /></div></div>
      <div class="p-5"><h2 class="text-h2">DayDial small on paper</h2><div class="mt-4"><DayDial sky={sky} size="small" selected="scorpio" id="sg-2" /></div></div>
    </section>

    <section class="mt-8"><h2 class="text-h2">ChipGrid</h2><div class="mt-4"><ChipGrid items={signChips()} set="western" selected="scorpio" /></div></section>
    <section class="mt-8 max-w-reading"><h2 class="text-h2">ReadingSection</h2><div class="mt-4"><ReadingSection reading={reading} prevHref="#" nextHref="#" showHeader={false} /></div></section>
    <section class="mt-8 max-w-reading"><h2 class="text-h2">CompatibilityResult</h2><div class="mt-4"><CompatibilityResult a={rat} b={dragon} set="animal" relationName={RELATION_NAME[cs.relation]} score={cs} /></div></section>
    <p class="mt-8 text-small text-muted">AlmanacCalendar: see any <a class="link" href={`/lucky-days/${today.slice(0, 4)}/${today.slice(5, 7)}/`}>Lucky days month</a>. AdSlot and AffiliateBox render nothing while their flags are off in src/config/site.ts.</p>
  </div>
</BaseLayout>
<style>
  .swatch { width: 24px; height: 24px; border-radius: 4px; border: 1px solid var(--rule); display: inline-block; }
  .night-band { background: var(--night); color: var(--night-ink); }
</style>
