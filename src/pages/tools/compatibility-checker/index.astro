---
/** Compatibility checker (plan §8): pick Western or Chinese, two of each, see the result here. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SIGNS } from "../../../lib/western";
import { ANIMALS } from "../../../lib/chinese";
---
<BaseLayout title="Compatibility checker" description="Check zodiac compatibility for any two Western signs or Chinese animals: overall match, love, friendship and work." breadcrumbs={[{ name: "Compatibility checker", href: "/tools/compatibility-checker/" }]}>
  <div class="mx-auto max-w-reading safe-x py-6 box-content">
    <h1 class="text-h1">Compatibility checker</h1>
    <p class="reading mt-3 text-muted">Choose a system and two signs. You'll go straight to the full pair page.</p>
    <form id="checker" class="mt-6 flex flex-col gap-5" action="/compatibility/" method="get">
      <fieldset>
        <legend class="label">System</legend>
        <div class="flex flex-wrap gap-5">
          <label class="inline-flex min-h-tap items-center gap-2"><input type="radio" name="type" value="western" checked class="size-5" /> Western signs</label>
          <label class="inline-flex min-h-tap items-center gap-2"><input type="radio" name="type" value="chinese" class="size-5" /> Chinese animals</label>
        </div>
      </fieldset>
      {[["a", "First"], ["b", "Second"]].map(([k, label], i) => (
        <div>
          <label class="label" for={`pick-${k}`}>{label}</label>
          <select class="field" id={`pick-${k}`} name={k}>
            <optgroup label="Western signs" data-group="western">{SIGNS.map((s, j) => <option value={s.slug} selected={j === i * 4}>{s.name}</option>)}</optgroup>
            <optgroup label="Chinese animals" data-group="chinese" disabled hidden>{ANIMALS.map((s) => <option value={s.slug}>{s.name}</option>)}</optgroup>
          </select>
        </div>
      ))}
      <div><button type="submit" class="btn-primary">Check compatibility</button></div>
    </form>
  </div>
</BaseLayout>
<script>
  const form = document.getElementById("checker") as HTMLFormElement;
  const selects = [...form.querySelectorAll("select")];
  const sync = (type: string, keep?: Record<string, string>) => {
    selects.forEach((sel, i) => {
      sel.querySelectorAll<HTMLOptGroupElement>("optgroup").forEach((g) => {
        const on = g.dataset.group === type;
        g.disabled = !on;
        g.hidden = !on;
      });
      const want = keep?.[sel.name];
      const opts = [...sel.querySelectorAll<HTMLOptionElement>(`optgroup[data-group="${type}"] option`)];
      sel.value = (want && opts.some((o) => o.value === want) ? want : opts[i === 0 ? 0 : 4].value);
    });
  };
  form.querySelectorAll<HTMLInputElement>('input[name="type"]').forEach((r) => r.addEventListener("change", () => sync(r.value)));
  // Accept ?type=&a=&b= from the PairPicker no-JS fallback.
  const q = new URLSearchParams(location.search);
  const type = q.get("type") === "chinese" ? "chinese" : "western";
  (form.querySelector(`input[value="${type}"]`) as HTMLInputElement).checked = true;
  sync(type, { a: q.get("a") ?? "", b: q.get("b") ?? "" });
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const t = fd.get("type") === "chinese" ? "chinese-compatibility" : "compatibility";
    const [x, y] = [String(fd.get("a")), String(fd.get("b"))].sort();
    location.href = `/${t}/${x}-and-${y}/`;
  });
</script>
